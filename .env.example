# InterviewLens AI Environment Configuration Template

# Server & Security
PROJECT_NAME="InterviewLens AI"
TAGLINE="Every interview makes you better."
SECRET_KEY="generate-a-strong-random-32-byte-secret-for-production"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
API_V1_STR="/api/v1"

# Database Configuration
# For local development with zero dependencies:
DATABASE_URL="sqlite:///./interviewlens.db"
# For production PostgreSQL:
# DATABASE_URL="postgresql://interviewlens:password@postgres-host:5432/interviewlens_db"

# Storage
STORAGE_DIR="./storage"
MAX_UPLOAD_SIZE_MB=250
MAX_RECORDING_DURATION_MINUTES=45

# AI Provider Selection
# Options: 'local' (offline high-fidelity engine), 'gemini', 'openai'
AI_PROVIDER="local"

# External Model Credentials (Optional - Local engine functions completely without them)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Redis Task Queue (For production Celery worker)
REDIS_URL="redis://localhost:6379/0"

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000", "https://*.vercel.app"]
